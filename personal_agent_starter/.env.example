# Start in free demo mode. No AI API key is needed for the prototype.
DEMO_MODE=true

# To enable live AI later, set DEMO_MODE=false and add your provider key locally.
OPENAI_API_KEY=
AGENT_MODEL=gpt-4.1-mini

# Local development defaults. Cloud hosting may require a managed database later.
WORKSPACE_DIR=./workspace
DATABASE_PATH=./agent.db
